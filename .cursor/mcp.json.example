{
  "mcpServers": {
    "bigquery": {
      "command": "uvx",
      "args": ["mcp-server-bigquery", "--project", "<GCP_PROJECT_ID>", "--location", "US"]
    },
    "looker": {
      "command": "npx",
      "args": ["-y", "@toolbox-sdk/server", "--prebuilt", "looker,looker-dev", "--stdio"],
      "envFile": "${workspaceFolder}/.cursor/looker.env"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "envFile": "${workspaceFolder}/.cursor/github.env"
    }
  }
}
